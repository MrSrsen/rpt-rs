# Baselines are compared as exact strings against output written with `\n`, so a CRLF checkout fails
# every one of them at once and reads as a decode regression.
* text=auto eol=lf

# The fixture corpus is the bytes under test, and a line-ending rewrite inside one corrupts it. Git
# would usually detect these as binary anyway; stating it means no `core.autocrlf` can reach them.
*.rpt binary
*.ttf binary
*.png binary
*.thumbnail binary

# GitHub language statistics (linguist).
#
# This is a Rust workspace, but the committed render/decode regression baselines are megabytes of
# machine-generated JSON — enough to skew the language breakdown. Marking them
# `linguist-generated` keeps them out of it.
tests/fixtures/baselines/** linguist-generated=true
tests/meridian/baselines/** linguist-generated=true
crates/*/tests/golden/** linguist-generated=true

# The design mock-up is a hand-written reference page, not a Rust source file, and it is not something
# the language stats should count either.
tests/meridian/template/design-mockup/** linguist-documentation=true

# Generated from the lock file by scripts/gen-third-party-notices.sh — reproduced upstream licence
# texts, not prose anyone writes here.
THIRD-PARTY-NOTICES.md linguist-generated=true
